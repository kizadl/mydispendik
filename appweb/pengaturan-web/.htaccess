<IfModule mod_rewrite.c>
RewriteEngine on

RewriteRule ^login.html$ login.php [L]
RewriteRule ^logout.html$ logout.php [L]
RewriteRule ^home.html$ home.php [L]
RewriteRule ^tampilkan-(.*)\.html$ tampilkan-dokumen-pdf.php?idinformasi=$1 [L]

</IfModule>

# secure htaccess file
<Files .htaccess>
order allow,deny
deny from all
#allow from env=ajax
</Files>

options All -Indexes