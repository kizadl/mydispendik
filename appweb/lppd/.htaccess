<IfModule mod_rewrite.c>
RewriteEngine on

RewriteRule ^login.html$ login.php [L]
RewriteRule ^logout.html$ logout.php [L]
RewriteRule ^home.html$ home.php [L]

RewriteRule ^rombel-sd-(.*)\.html$ aksi/lap-excel/excel_lap_rombel_sd.php?filterrombel=$1 [L]
RewriteRule ^rombel-smp-(.*)\.html$ aksi/lap-excel/excel_lap_rombel_smp.php?filterrombel=$1 [L]

RewriteRule ^kebutuhan-guru-sd-(.*)\.html$ aksi/lap-excel/excel_lap_kebutuhan_guru_sd.php?filterkebutuhan=$1 [L]
RewriteRule ^kebutuhan-guru-smp-(.*)\.html$ aksi/lap-excel/excel_lap_kebutuhan_guru_smp.php?filterkebutuhan=$1 [L]

RewriteRule ^pembelajaran-(.*)\.html$ aksi/lap-excel/excel_lap_pembelajaran.php?idsekolah=$1 [L]
</IfModule>

# secure htaccess file
<Files .htaccess>
order allow,deny
deny from all
#allow from env=ajax
</Files>

options All -Indexes